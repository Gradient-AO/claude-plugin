{
  "schema_version": 2,
  "design_profile": "analytical",
  "forced_breaks": [],
  "pdf": {
    "target_pages": {
      "min": 2,
      "max": 5
    },
    "hard_max_pages": 8,
    "minimum_body_fill": 0.4,
    "orphan_tail_max_fill": 0.2
  },
  "content": {
    "defaults": {},
    "sections": {}
  },
  "selector": {
    "path": "meta.week_kind",
    "default": "active"
  },
  "modes": {
    "active": {
      "content": {
        "defaults": {
          "max_pages": 2,
          "max_words": 450,
          "max_body_table_rows": 24,
          "max_visuals": 4
        },
        "sections": {
          "executive": {
            "role": "summary",
            "requires_analysis": false,
            "max_body_table_rows": 12,
            "max_visuals": 3
          },
          "changes-alerts": {
            "role": "analytical",
            "requires_analysis": true,
            "max_body_table_rows": 18,
            "max_visuals": 2
          },
          "review-calendar": {
            "role": "analytical",
            "requires_analysis": true,
            "max_body_table_rows": 16,
            "max_visuals": 2
          },
          "coverage-freshness": {
            "role": "reference",
            "requires_analysis": false,
            "max_body_table_rows": 0,
            "max_visuals": 1
          },
          "sources-method": {
            "role": "appendix",
            "requires_analysis": false,
            "max_pages": 2,
            "max_words": 350,
            "max_body_table_rows": 16,
            "max_visuals": 0
          }
        }
      }
    },
    "quiet": {
      "content": {
        "defaults": {
          "max_pages": 2,
          "max_words": 450,
          "max_body_table_rows": 24,
          "max_visuals": 4
        },
        "sections": {
          "executive": {
            "role": "summary",
            "requires_analysis": false,
            "max_body_table_rows": 12,
            "max_visuals": 3
          },
          "review-calendar": {
            "role": "analytical",
            "requires_analysis": true,
            "max_body_table_rows": 16,
            "max_visuals": 2
          },
          "coverage-freshness": {
            "role": "reference",
            "requires_analysis": false,
            "max_body_table_rows": 0,
            "max_visuals": 1
          },
          "sources-method": {
            "role": "appendix",
            "requires_analysis": false,
            "max_pages": 2,
            "max_words": 350,
            "max_body_table_rows": 16,
            "max_visuals": 0
          }
        }
      }
    }
  }
}
