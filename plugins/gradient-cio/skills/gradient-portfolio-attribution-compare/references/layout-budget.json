{
  "schema_version": 2,
  "design_profile": "analytical",
  "forced_breaks": [],
  "selector": {
    "path": "meta.mode",
    "default": "fallback"
  },
  "pdf": {
    "target_pages": {
      "min": 6,
      "max": 10
    },
    "hard_max_pages": 12,
    "minimum_body_fill": 0.4,
    "orphan_tail_max_fill": 0.2
  },
  "content": {
    "defaults": {
      "max_pages": 2,
      "max_words": 450,
      "max_visuals": 4,
      "max_body_table_rows": 24
    },
    "sections": {
      "executive": {
        "role": "summary",
        "requires_analysis": false
      },
      "scope": {
        "role": "reference",
        "requires_analysis": false
      },
      "historical": {
        "role": "analytical",
        "requires_analysis": true,
        "max_visuals": 5
      },
      "ex-ante": {
        "role": "analytical",
        "requires_analysis": true
      },
      "simulated": {
        "role": "analytical",
        "requires_analysis": true
      },
      "comparison": {
        "role": "analytical",
        "requires_analysis": true,
        "max_visuals": 5
      },
      "coverage": {
        "role": "reference",
        "requires_analysis": false
      },
      "appendix-a": {
        "role": "appendix",
        "requires_analysis": false
      }
    }
  },
  "modes": {
    "fallback": {
      "forced_breaks": []
    },
    "three_lane": {
      "forced_breaks": [
        "simulated",
        "comparison",
        "appendix-a"
      ],
      "content": {
        "sections": {
          "3": {
            "role": "analytical",
            "requires_analysis": true,
            "max_visuals": 5
          },
          "6": {
            "role": "analytical",
            "requires_analysis": true,
            "max_visuals": 5
          }
        }
      }
    }
  }
}
