{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradientcio.com/contracts/idd-odd-ic-handoff/v1",
  "title": "GradientCIO IDD to ODD to IC handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "subject",
    "return_series",
    "evidence",
    "limitations",
    "selection"
  ],
  "properties": {
    "schema_version": {
      "const": "gradient-idd-odd-ic-handoff/v1"
    },
    "stage": {
      "enum": ["idd", "odd", "decision"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manager_id": { "type": ["string", "null"] },
        "firm_id": { "type": ["string", "null"] },
        "fund_id": { "type": ["string", "null"] },
        "name": { "type": "string", "minLength": 1 },
        "identity_status": {
          "enum": ["canonical", "linked", "advisory", "unresolved"]
        }
      },
      "required": ["name", "identity_status"]
    },
    "return_series": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "return_series_id",
          "benchmark_series_id",
          "benchmark_rationale"
        ],
        "properties": {
          "return_series_id": { "type": "string", "minLength": 1 },
          "benchmark_series_id": { "type": ["string", "null"] },
          "benchmark_rationale": { "type": "string", "minLength": 1 },
          "start_date": { "type": ["string", "null"], "format": "date" },
          "end_date": { "type": ["string", "null"], "format": "date" },
          "observation_count": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_tag", "tool", "as_of", "methodology_version"],
        "properties": {
          "source_tag": { "type": "string", "pattern": "^S[0-9]+$" },
          "tool": { "type": "string", "minLength": 1 },
          "as_of": { "type": ["string", "null"] },
          "methodology_version": { "type": ["string", "null"] },
          "digest": { "type": ["string", "null"] }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "enum": ["selected", "reserve", "rejected", "not_assessed"]
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "odd_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "severity", "source_tags"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["low", "medium", "high"] },
          "source_tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^S[0-9]+$" }
          }
        }
      }
    }
  }
}
