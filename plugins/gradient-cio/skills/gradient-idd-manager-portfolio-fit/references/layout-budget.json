{
  "schema_version": 2,
  "design_profile": "analytical",
  "forced_breaks": [],
  "pdf": {
    "target_pages": {
      "min": 4,
      "max": 9
    },
    "hard_max_pages": 12,
    "minimum_body_fill": 0.4,
    "orphan_tail_max_fill": 0.2
  },
  "content": {
    "defaults": {
      "max_pages": 2,
      "max_words": 500,
      "max_visuals": 4,
      "max_body_table_rows": 24
    },
    "sections": {
      "1": {
        "role": "summary",
        "requires_analysis": false
      },
      "2": {
        "role": "reference",
        "requires_analysis": false
      },
      "3": {
        "role": "analytical",
        "requires_analysis": true
      },
      "4": {
        "role": "analytical",
        "requires_analysis": true
      },
      "5": {
        "role": "analytical",
        "requires_analysis": true
      },
      "6": {
        "role": "closing",
        "requires_analysis": false
      },
      "7": {
        "role": "appendix",
        "requires_analysis": false
      }
    }
  }
}
